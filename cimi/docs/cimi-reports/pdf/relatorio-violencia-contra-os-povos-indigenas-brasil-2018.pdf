   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">GP0STSKHN</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Aerial view</rdf:li>
     <rdf:li>Day</rdf:li>
     <rdf:li>Deforestation</rdf:li>
     <rdf:li>Forests (campaign title)</rdf:li>
     <rdf:li>Illegal logging</rdf:li>
     <rdf:li>KWCI (GPI)</rdf:li>
     <rdf:li>Outdoors</rdf:li>
