# virtual envs
.venv/
*-venv/
venv/
env/
ENV/
virtualenv/
.virtualenv/
venv-*/
*.venv/
*.pyvenv/

# data transfers in and out are reproducible downloads; keep only notes.
# Patterns are anchored to the repository root, so the project subdirectory has
# to be spelled out: a bare "data/raw/*" matches nothing under cimi/.
cimi/data/raw/*
!cimi/data/raw/README.md

# generated tables; the cimi project tracks the small derived CSVs and the
# figure outputs on purpose, so nothing under cimi/data/derived/ is ignored

__pycache__/
*.pyc

# notebook cruft
.ipynb_checkpoints/
*:Zone.Identifier

# OS cruft
.DS_Store
